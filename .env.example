TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_ALLOWED_USER_IDS=123456789
SPENDLENS_DATA_DIR=./data
SPENDLENS_MAX_SOURCE_BYTES=26214400

SPENDLENS_EXTRACTION_ENABLED=true

# Local OCR on Apple Silicon via mlx-vlm.
LOCAL_OCR_PRIMARY_MODEL=mlx-community/PaddleOCR-VL-1.6-4bit
LOCAL_OCR_SECONDARY_ENABLED=true
LOCAL_OCR_SECONDARY_MODEL=mlx-community/dots.ocr-4bit
LOCAL_OCR_MAX_TOKENS=4096

# Local text-only structurer. Existing OLLAMA_MODEL is still accepted as an alias.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_STRUCTURER_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=180

# Optional cloud fallback. Disabled by default.
CLOUD_FALLBACK_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ocr_text sends local OCR text only. image sends the receipt image to Google.
GEMINI_FALLBACK_MODE=ocr_text
